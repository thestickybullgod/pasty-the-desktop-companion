<bodies:CharacterBody xmlns="https://github.com/avaloniaui"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:bodies="using:Pasty.Desktop.Character.Bodies"
                      x:Class="Pasty.Desktop.Character.Bodies.PastyBody"
                      Width="140" Height="184">
    <!-- Pasty since 1.3: a bottle of school glue with a pointy orange twist cap. Generic shape, Pasty's own label. -->
    <bodies:CharacterBody.Resources>
        <StreamGeometry x:Key="Bottle">M 30,166 V 86 C 30,68 40,58 56,54 L 58,47 H 82 L 84,54 C 100,58 110,68 110,86 V 166 Q 110,174 102,174 H 38 Q 30,174 30,166 Z</StreamGeometry>
        <SolidColorBrush x:Key="Ink" Color="#2B3442" />
    </bodies:CharacterBody.Resources>

    <Canvas x:Name="BackLayer" Width="140" Height="184">
        <!-- Bottle -->
        <Path Data="{StaticResource Bottle}" Stroke="{StaticResource Ink}" StrokeThickness="2.5">
            <Path.Fill>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Color="#D9E0E8" Offset="0" />
                    <GradientStop Color="#FFFFFF" Offset="0.3" />
                    <GradientStop Color="#F4F6F9" Offset="0.64" />
                    <GradientStop Color="#C3CCD7" Offset="1" />
                </LinearGradientBrush>
            </Path.Fill>
        </Path>

        <Canvas Width="140" Height="184" Clip="{StaticResource Bottle}">
            <!-- Label panel: coral with the white swirl -->
            <Rectangle x:Name="Band" Canvas.Left="36" Canvas.Top="126" Width="68" Height="38" RadiusX="7" RadiusY="7" Fill="#FF6B57" Stroke="#C94A38" StrokeThickness="1.5" />
            <Rectangle Canvas.Left="40" Canvas.Top="129" Width="60" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="#FFFFFF" Opacity="0.35" />
            <Path x:Name="BandSwirl" Data="M 46,146 q 6,-7 12,0 t 12,0 t 12,0 t 12,0" Stroke="#FFFFFF" StrokeThickness="3.2" StrokeLineCap="Round" />
            <!-- Gloss streak and right-side shade -->
            <Rectangle Canvas.Left="37" Canvas.Top="72" Width="5" Height="92" RadiusX="2.5" RadiusY="2.5" Fill="#FFFFFF" Opacity="0.8" />
            <Rectangle Canvas.Left="102" Canvas.Top="60" Width="8" Height="114" Fill="#6F829A" Opacity="0.14" />
        </Canvas>
    </Canvas>

    <!-- Pointy orange twist cap -->
    <Canvas x:Name="TopLayer" Width="140" Height="184">
        <Path x:Name="Nozzle" Data="M 58,32 L 66,9 Q 70,4 74,9 L 82,32 Z" Stroke="#8A3A06" StrokeThickness="2.2">
            <Path.Fill>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Color="#FFA04A" Offset="0" />
                    <GradientStop Color="#FF7A1A" Offset="0.5" />
                    <GradientStop Color="#C9520A" Offset="1" />
                </LinearGradientBrush>
            </Path.Fill>
        </Path>
        <Rectangle x:Name="Collar" Canvas.Left="50" Canvas.Top="30" Width="40" Height="19" RadiusX="5" RadiusY="5" Stroke="#8A3A06" StrokeThickness="2.2">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Color="#FFA04A" Offset="0" />
                    <GradientStop Color="#FF7A1A" Offset="0.45" />
                    <GradientStop Color="#C9520A" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Path x:Name="Ridges" Stroke="#8A3A06" StrokeThickness="1.6" Opacity="0.5"
              Data="M 56,34 V 45 M 62,34 V 45 M 68,34 V 45 M 74,34 V 45 M 80,34 V 45 M 86,34 V 45" />
        <Path Data="M 64,20 L 67,11" Stroke="#FFFFFF" StrokeThickness="2.2" StrokeLineCap="Round" Opacity="0.8" />
        <Path Data="M 54,37 Q 54,33 58,33" Stroke="#FFFFFF" StrokeThickness="2" StrokeLineCap="Round" Opacity="0.75" />
    </Canvas>
</bodies:CharacterBody>
