<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe: no console window on Windows. On Linux this is an ordinary executable. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Pasty</AssemblyName>
    <RootNamespace>Pasty.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Version>1.0.0</Version>
    <InformationalVersion>1.0.0 "Halloween Launch"</InformationalVersion>
    <Product>Pasty</Product>
    <Description>Pasty, your desktop companion. Born on Halloween 2026.</Description>
    <ApplicationIcon>..\..\assets\pasty.ico</ApplicationIcon>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <!-- DPAPI for the Windows secret store. Only called on Windows. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pasty.Core\Pasty.Core.csproj" />
    <ProjectReference Include="..\Pasty.Brains.Claude\Pasty.Brains.Claude.csproj" />
  </ItemGroup>

</Project>
