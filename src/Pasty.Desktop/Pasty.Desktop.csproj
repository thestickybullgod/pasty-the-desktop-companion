<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe: no console window on Windows. On Linux this is an ordinary executable. -->
    <OutputType>WinExe</OutputType>
    <!--
      net10.0: Linux (and any OS). net10.0-windows: Windows builds, adding WinRT APIs for the
      Microsoft Store package (startup task, launch detection). Same code; Windows-only parts are #if'd.
    -->
    <TargetFrameworks>net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-windows'))">10.0.17763.0</SupportedOSPlatformVersion>
    <!-- Lets Linux/macOS machines build the Windows target too. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Pasty</AssemblyName>
    <RootNamespace>Pasty.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Version>1.2.0</Version>
    <InformationalVersion>1.2.0</InformationalVersion>
    <Product>Pasty the Desktop Companion</Product>
    <AssemblyTitle>Pasty the Desktop Companion</AssemblyTitle>
    <Description>Pasty the Desktop Companion. Born on Halloween 2026.</Description>
    <ApplicationIcon>..\..\assets\pasty.ico</ApplicationIcon>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <!-- DPAPI for the Windows secret store. Only called on Windows. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pasty.Core\Pasty.Core.csproj" />
    <ProjectReference Include="..\Pasty.Brains.Claude\Pasty.Brains.Claude.csproj" />
    <ProjectReference Include="..\Pasty.Brains.OpenAICompatible\Pasty.Brains.OpenAICompatible.csproj" />
  </ItemGroup>

</Project>
